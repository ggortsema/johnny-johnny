	<artifactId>chat-api</artifactId>

	<dependencies>
		<dependency>
			<groupId>com.grant</groupId>
			<artifactId>chat-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.grant</groupId>
			<artifactId>chat-rules</artifactId>
			<version>${project.version}</version>
		</dependency>
